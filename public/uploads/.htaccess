# Nothing in this folder is meant to be fetched directly by URL.
# Requirement files and event photos are streamed by PHP instead
# (public/api/attachment.php and admin/api/attachment.php), which
# checks the session first so one student can't read another's
# documents just by guessing a filename.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Belt and braces: even if the rule above is ever lost, never let
# anything in here be executed as a script.
php_flag engine off
AddType text/plain .php .php3 .php4 .php5 .phtml .pl .py .cgi .asp .sh
